{
  "expo": {
    "name": "Edvantage",
    "slug": "edvantaemobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edvantagemobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "Allow access to select a profile picture.",
        "NSLocationWhenInUseUsageDescription": "Edvantage uses your location to verify you are physically present in class before marking attendance.",
        "NSLocationAlwaysUsageDescription": "Edvantage uses your location to verify attendance."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.FOREGROUND_SERVICE",
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FAFBFD"
      },
      "package": "com.akinoluwa.edvantage.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#007AFF",
          "sounds": [],
          "iosDisplayInForeground": true,
          "androidMode": "default",
          "androidChannels": [
            {
              "id": "alarms",
              "name": "Alarms",
              "importance": "max",
              "sound": true,
              "vibrate": [
                0,
                250,
                250,
                250
              ]
            },
            {
              "id": "notifications",
              "name": "Notifications",
              "importance": "default",
              "sound": true,
              "vibrate": [
                0,
                250
              ]
            }
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Edvantage uses your GPS to verify your physical presence inside the classroom before marking attendance."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFBFD"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://edvantage.com.ng/api",
      "router": {},
      "eas": {
        "projectId": "cf817760-30d6-43d1-bd4e-8847cb512698"
      }
    },
    "owner": "akinoluwa"
  }
}
